<!DOCTYPE html>
<html lang="en" data-site="reclaimhomerepair.com">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{% if seo and seo.description %}{{ seo.description }}{% elif description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title }}">
  <meta property="og:description" content="{% if seo and seo.description %}{{ seo.description }}{% else %}{{ site.description }}{% endif %}">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#efe8da">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+SC:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap">
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="stylesheet" href="/assets/css/reclaim.css">
  {% include "components/schema.njk" %}
  <script src="/assets/js/cta.js" defer></script>
</head>
<body class="has-contact-bar reclaim">
  <main class="sheet sheet--wide">
    <header class="masthead masthead--reclaim">
      <a href="/" class="brandmark">{% include "components/mark.njk" %}<span>Reclaim <small>Home Repair</small></span></a>
      <a class="masthead-phone" href="tel:{{ site.phoneE164 }}">{{ site.phoneDots }}</a>
    </header>

    {{ content | safe }}

    {% include "components/footer.njk" %}
  </main>
  {% include "components/contact-bar.njk" %}
</body>
</html>
