{# Rocco-style credentials list: facts only. Items appear when "show" is true in _data/credentials.json. #}
<ul class="checks" aria-label="Why you can trust the work">
  {% for c in credentials %}{% if c.show %}
  <li>{% if c.url %}<a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.text }}</a>{% else %}{{ c.text }}{% endif %}</li>
  {% endif %}{% endfor %}
</ul>
