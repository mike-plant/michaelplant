{# Answer-first Q&A for people and AI assistants. Data: `faq` in front matter, a list of { q, a }.
   Each answer opens with the direct answer in one or two sentences. Only facts Mike has confirmed. #}
{% if faq and faq.length %}
<section class="faq-list" aria-labelledby="faq-h">
  <h2 id="faq-h">{{ faqTitle or "Questions people ask" }}</h2>
  {% for item in faq %}
  <h3>{{ item.q }}</h3>
  <p>{{ item.a }}</p>
  {% endfor %}
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{% for item in faq %}{ "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
{% endif %}
