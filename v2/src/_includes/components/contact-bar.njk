{# Mobile-only bar on every page. The primary action (Text me) gets the filled, double-width cell. #}
<nav class="contact-bar" aria-label="Contact {{ site.nickname }}">
  <a class="primary" href="sms:{{ site.phoneE164 }}?&body={{ card.textBody | urlencode }}">Text me</a>
  <a href="tel:{{ site.phoneE164 }}">Call</a>
  <a href="/mike.vcf">Save</a>
</nav>
