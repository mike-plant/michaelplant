{% if bridges and bridges.length %}
<section aria-labelledby="keep-reading">
  <h2 id="keep-reading">Keep Reading</h2>
  <ul class="list">
    {% for b in bridges %}
    <li><a class="entry" href="{{ b.url }}">
      <span class="t">{{ b.label }}</span>
      {% if b.because %}<span class="d">{{ b.because }}</span>{% endif %}
      <span class="go">Read &rarr;</span></a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
