---
layout: layouts/base.njk
hideMasthead: true
---
{#
  The calling-card page: home (/) and the QR target (/connect/).
  Words: _data/card.json · list: _data/paths.json · name/phone/email: _data/site.json
#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Michael Plant",
  "alternateName": "Mike Plant",
  "url": "{{ site.url }}/",
  "image": "{{ site.url }}{{ site.portrait }}",
  "telephone": "{{ site.phoneE164 }}",
  "email": "{{ site.email }}",
  "address": { "@type": "PostalAddress", "addressLocality": "Lakewood", "addressRegion": "OH", "addressCountry": "US" }{% set links = [] %}{% if site.realtorSite %}{% set links = (links.push(site.realtorSite), links) %}{% endif %}{% if site.reclaimSite %}{% set links = (links.push(site.reclaimSite), links) %}{% endif %}{% if links.length %},
  "sameAs": {{ links | dump | safe }}{% endif %}
}
</script>
<header class="top">
  <img class="portrait" src="{{ site.portrait }}" alt="Engraved portrait of {{ site.author }}, smiling" width="720" height="678">
  <h1 class="name">{{ site.author }}</h1>
  <p class="place">{{ site.city }}, Ohio</p>
</header>

<div class="intro">
  <p class="hi">{{ card.hi }}</p>
  <p>{{ card.about }}</p>
  <p class="lead">{{ card.lead }}</p>
  <div class="actions">
    <a class="btn solid" href="sms:{{ site.phoneE164 }}?&body={{ card.textBody | urlencode }}" data-cta="hero">Text me</a>
    <a class="btn" href="/mike.vcf" data-cta="hero">Save my contact</a>
  </div>
  <p class="reassure">{{ card.reassure }}</p>
  <p class="number">{{ site.phoneDots }} <button class="copy" type="button" id="copy-number" data-copy="{{ site.phoneDashes }}">Copy</button></p>
</div>

<section aria-labelledby="part-of">
  <h2 id="part-of">{{ card.partOfHeading }}</h2>
  <ul class="list">
    {% for p in paths %}
    {% set url = site[p.urlFromSite] if (p.urlFromSite and site[p.urlFromSite]) else p.url %}
    {% if url %}{% set href = url %}{% else %}{% set href = "sms:" + site.phoneE164 + "?&body=" + (p.fallbackSms | urlencode) %}{% endif %}
    {% set go = p.goWithUrl if (url and p.goWithUrl) else p.go %}
    <li><a class="entry" href="{{ href }}"{% if p.external or (url and url.startsWith("http")) %} target="_blank" rel="noopener"{% endif %} data-cta="part-of">
      <span class="t">{{ p.title }}</span>
      <span class="d">{{ p.detail }}</span>
      <span class="go">{{ go }} &rarr;</span></a></li>
    {% endfor %}
  </ul>
</section>

<section class="bottom" aria-labelledby="coffee">
  <p class="big" id="coffee">{{ card.coffee }}</p>
  <p class="sub">{{ card.coffeeSub }}</p>
  <div class="actions"><a class="btn solid" href="sms:{{ site.phoneE164 }}?&body={{ card.textBody | urlencode }}" data-cta="end">Text me</a></div>
  <dl class="contact">
    <dt>Phone</dt><dd><a href="tel:{{ site.phoneE164 }}">{{ site.phoneDots }}</a></dd>
    <dt>Email</dt><dd><a href="mailto:{{ site.email }}">{{ site.email }}</a></dd>
  </dl>
  <p class="toast" id="toast" role="status" aria-live="polite"></p>
</section>

{{ content | safe }}

<script>
(function () {
  var toast = document.getElementById('toast');
  var btn = document.getElementById('copy-number');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var v = btn.getAttribute('data-copy');
    function done() { toast.textContent = 'Number copied.'; btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = 'Copy'; }, 1800); }
    function fail() { toast.textContent = 'Copy is blocked here. The number is {{ site.phoneDots }}.'; }
    try { navigator.clipboard.writeText(v).then(done, fail); } catch (e) { fail(); }
  });
})();
</script>
