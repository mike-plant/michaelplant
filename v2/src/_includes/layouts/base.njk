<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{% if seo.description %}{{ seo.description }}{% else %}{{ site.description }}{% endif %}">
  {% if seo and seo.ogImage %}<meta property="og:image" content="{{ site.url }}{{ seo.ogImage }}">{% endif %}
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title }}">
  <meta property="og:description" content="{% if seo and seo.description %}{{ seo.description }}{% else %}{{ site.description }}{% endif %}">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/assets/css/global.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/bubble.css">
  <link rel="stylesheet" href="/assets/css/search.css">
  <link rel="stylesheet" href="/assets/css/connect.css">
  <script>window.MP_CONFIG = { hubspot: {{ site.hubspot | dump | safe }} };</script>
  <script src="/assets/js/lead.js"></script>
</head>
{% set nc = bridges | neighborColors(section) %}
<body{% if not hideContactBar %} class="has-contact-bar"{% endif %}{% if section %} data-section="{{ section }}"{% endif %}{% if nc | length %} style="--neighbor-1: {{ nc[0] }};{% if nc[1] %} --neighbor-2: {{ nc[1] }};{% endif %}"{% endif %}>
  {% if not hideChrome %}
  {% if section == "real-estate" %}
  <a href="/" class="name-anchor name-anchor--brokerage">Michael Plant <span class="name-anchor-sep" aria-hidden="true">|</span> {{ site.brokerage.name }}</a>
  {% else %}
  <a href="/" class="name-anchor">Michael Plant</a>
  {% endif %}
  {% include "components/bubble.njk" %}
  {% endif %}
  <main>
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  {% if not hideContactBar %}{% include "components/contact-bar.njk" %}{% endif %}
</body>
</html>
