---
layout: layouts/base.njk
---
<article class="page-content">
  <header class="page-hero">
    <h1>{{ title }}</h1>
  </header>

  <div class="page-body">
    {{ content | safe }}
  </div>

  {% if pageCta %}
  <div class="page-cta-inline">
    <p>{{ pageCta.text }}</p>
    <a href="{{ pageCta.url }}">{{ pageCta.label }} &rarr;</a>
  </div>
  {% endif %}
</article>

