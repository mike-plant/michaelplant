---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}index.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Moved</title>
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ r.to }}">
  <meta http-equiv="refresh" content="0; url={{ r.to }}">
</head>
<body>
  <p>This page has moved: <a href="{{ r.to }}">{{ r.to }}</a></p>
</body>
</html>
